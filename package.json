  },
  "homepage": "https://github.com/De22323/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/De22323/dsh-memory/issues"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts/",
    "template/",
    "README.md"
  ],
  "dsh": {
